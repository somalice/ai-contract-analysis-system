# ============================================
# 智能合同与投标管理平台 - 环境变量配置示例(v1.0.0)
# ============================================
# 使用方法:复制本文件为 .env 并填入真实值
#   cp .env.example .env
#
# 注意:.env 文件包含敏感信息,切勿提交到 Git 仓库(已被 .gitignore 忽略)
# ============================================

# ---------- Flask ----------
# 会话密钥(生产环境必须修改;默认值仅与 legacy 行为保持一致)
SECRET_KEY=supersecretkey
# 运行环境:development / production
FLASK_ENV=development

# ---------- DeepSeek ----------
# API Key(必填,获取地址:https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_api_key_here
# API 基础 URL(默认与 legacy 硬编码一致)
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# 模型名称(默认与 legacy 硬编码一致)
DEEPSEEK_MODEL=deepseek-chat

# ---------- 数据库(Sprint 1:用户表)----------
# 默认 SQLite 本地文件;生产可改为 MySQL:
#   SQLALCHEMY_DATABASE_URI=mysql+pymysql://user:pass@localhost:3306/contract_platform
SQLALCHEMY_DATABASE_URI=sqlite:///instance/app.db

# ---------- JWT(Sprint 1 - v0.3.0,生产必须修改)----------
# JWT 签名密钥(生产环境必须设置为强随机串,禁止使用默认值)
JWT_SECRET_KEY=dev-jwt-secret-change-me-in-production
# Access Token 有效期(秒),默认 86400 = 24 小时
JWT_ACCESS_TOKEN_EXPIRES=86400

# ---------- 日志 ----------
# 日志级别:DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- CORS(Sprint 2 - v0.4.0 前端 Admin Console)----------
# 允许跨域访问 /api/* 的前端 Origin 列表(逗号分隔)
# 禁止使用 "*"(生产安全);开发默认为 Vite dev server 地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Embedding & Vector Store(Sprint 4 - v0.6.0 知识库 / RAG)----------
# Embedding 模型(中文优化;禁止使用 OpenAI Embedding)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 向量库存储目录(相对 backend 目录;默认 storage/vectorstore)
VECTOR_STORE_DIR=storage/vectorstore
# FAISS 索引文件名(默认 knowledge.faiss)
VECTOR_INDEX_NAME=knowledge.faiss
# 检索返回 TopK(默认 5)
RETRIEVER_TOP_K=5
# 检索相似度阈值(归一化余弦,低于此值视为不相关;默认 0.35)
RETRIEVER_SCORE_THRESHOLD=0.35

# ---------- Redis 缓存(Sprint 8 - v1.0.0 企业级 AI 增强)----------
# 连接串示例:
#   本地无密码:redis://localhost:6379/0
#   带密码:redis://:your_password@localhost:6379/0
# 未配置时自动降级为内存字典缓存,不影响业务(推荐本地开发保持空)
REDIS_URL=
# 总开关:false=禁用 Redis,直接走内存降级(便于调试)
CACHE_ENABLED=true
# RAG 查询结果缓存时长(秒),默认 3600 = 1 小时
CACHE_TTL_RAG=3600
# 合同审核结果缓存时长(秒),默认 300 = 5 分钟
CACHE_TTL_REVIEW=300

# ---------- LLM(Sprint 3+ 超时与重试)----------
# Agent 最大迭代次数(ReAct 循环上限)
MAX_AGENT_ITERATIONS=5
# LLM 请求总超时(秒)
LLM_TIMEOUT=20
# 连接超时(秒)
LLM_CONNECT_TIMEOUT=5
# 读取超时(秒)
LLM_READ_TIMEOUT=20
# 常规生成最大 Token 数
LLM_MAX_TOKENS=2000
# RAG 问答最大 Token 数(生成模式)
LLM_RAG_MAX_TOKENS=768
# LLM 失败重试次数
LLM_MAX_RETRIES=1

# ---------- RAG 检索与重排(Sprint 4 / 8.9)----------
# 检索返回 TopK(默认 5,生产建议 10)
RETRIEVER_TOP_K=10
# 是否启用 BGE Reranker 精排
RERANK_ENABLED=true
# Reranker 模型
RERANKER_MODEL=BAAI/bge-reranker-base
# 精排召回数(需 >= RETRIEVER_TOP_K)
RERANK_RECALL_K=10
# 精排最终保留数
RERANK_FINAL_TOP_K=3

# ---------- Chunk 切分(Sprint 4)----------
# 切分模式:auto / semantic / contract
CHUNKER_MODE=auto
# 契约文档自动切换阈值(页数)
CONTRACT_CHUNKER_AUTO_THRESHOLD=3
# 契约 Chunk 大小(字符)
CONTRACT_CHUNK_SIZE=800
# 契约 Chunk overlap(字符)
CONTRACT_CHUNK_OVERLAP=0
# 是否保留条款标题
CONTRACT_CHUNK_INCLUDE_TITLE=true
# 是否按条款分组
CONTRACT_CHUNK_GROUP_CLAUSES=false

# ---------- RAG 问答模式(Sprint 8.9 生产配置)----------
# 回答生成方式:
#   generate = LLM 基于检索上下文生成回答
#   extract  = 句级抽取式回答(零 LLM 成本,生产推荐)
RAG_ANSWER_MODE=extract
# extract 模式:抽取句子数
RAG_EXTRACT_TOP_N=3
# extract 模式:最小相似度阈值
RAG_EXTRACT_MIN_SIM=0.55
# 旧版上下文抽取模式(兼容保留,一般不配置)
# ANSWER_MODE=context_extract
# 上下文压缩开关(false=关闭)
# RAG_CONTEXT_COMPRESS=false
# 是否合并相邻上下文
# RAG_CONTEXT_MERGE_ADJACENT=false

# ---------- AI 评估(Sprint 8.5)----------
# 并行评估 Worker 数
EVALUATION_WORKERS=4
# 评估缓存开关
EVALUATION_CACHE_ENABLED=true
